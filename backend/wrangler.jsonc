{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "valora-nebius-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ENV": "production",
    "JWT_ISSUER": "https://valora-nebius-api.jadhav-rushikesh-ggl.workers.dev",
    "ALLOWED_ORIGINS": "",
    "AI_DEFAULT_PROVIDER": "nebius",
    "GOOGLE_CLIENT_ID": "835167251935-uv31077qlqatidou04dnd3475a0f9ub5.apps.googleusercontent.com",
    "GOOGLE_CALLBACK_URL": "https://valora-nebius-api.jadhav-rushikesh-ggl.workers.dev/v1/auth/google/callback",
    "MOBILE_AUTH_REDIRECT_URI": "valoranebius://auth/callback",
    "AI_NEBIUS_MODEL": "nvidia/nemotron-3-super-120b-a12b",
    "QLOO_ENABLED": "true",
    "QLOO_API_URL": "https://hackathon.api.qloo.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valora-nebius-db",
      "database_id": "56e7e18f-f37c-4fa4-a2c2-07cadc12bd67",
      "migrations_dir": "d1_migrations"
    }
  ],
  "account_id": "7d7db815f4a8f55e80adbe86d041a846"
}
